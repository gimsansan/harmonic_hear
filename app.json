{
  "expo": {
    "name": "HarmoniTune",
    "slug": "harmonitune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash.png",
    "scheme": "harmonitune",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash.png",
        "backgroundColor": "#c9c9c9"
      },
      "package": "com.vlondy.harmonitune"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-asset",
      "react-native-audio-api"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
